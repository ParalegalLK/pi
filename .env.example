PI_PROVIDER=google
PI_MODEL=gemini-3.7-flash
PI_THINKING=medium
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
REVIEWER_BASE_URL=http://127.0.0.1:8124
REVIEWER_INTEGRATION_TOKEN=
REVIEWER_COMPLETION_TIMEOUT_MS=1200000
RAG_BASE_URL=http://127.0.0.1:8123
RAG_API_KEY=

# Optional bounded direct source-detail retrieval. RAG Chat remains the primary
# researcher; this reads source material only when Pi needs deeper detail behind
# a cited authority. Each Typesense API key must be a search-only key scoped to
# its source; Lex uses its separately configured read-only service key below.
JUNIOR_TYPESENSE_ENABLED=false
JUNIOR_TYPESENSE_CHUNK_HOST=
JUNIOR_TYPESENSE_CHUNK_PORT=443
JUNIOR_TYPESENSE_CHUNK_PROTOCOL=https
JUNIOR_TYPESENSE_CHUNK_API_KEY=
JUNIOR_TYPESENSE_CHUNK_COLLECTION=paralegal
JUNIOR_TYPESENSE_DECISION_HOST=
JUNIOR_TYPESENSE_DECISION_PORT=443
JUNIOR_TYPESENSE_DECISION_PROTOCOL=https
JUNIOR_TYPESENSE_DECISION_API_KEY=
JUNIOR_TYPESENSE_DECISION_COLLECTION=paralegal
JUNIOR_TYPESENSE_BOOKS_HOST=
JUNIOR_TYPESENSE_BOOKS_PORT=443
JUNIOR_TYPESENSE_BOOKS_PROTOCOL=https
JUNIOR_TYPESENSE_BOOKS_PATH=/typesense
JUNIOR_TYPESENSE_BOOKS_API_KEY=
JUNIOR_TYPESENSE_BOOKS_COLLECTION=law_book_chunks
JUNIOR_TYPESENSE_MAX_RESULTS=8
JUNIOR_TYPESENSE_MAX_FIELD_CHARS=12000

# Structured Lex/SQLite source used for Acts, constitutional text and available
# amendment references. The Lex service-to-service authentication header is
# X-API-Key (not a Bearer token). With this read-only key, Pi can retrieve an
# Act's ordered original sections or one exact section by Act ID plus
# section_number. This is preferable to RAG Chat's inactive legislation
# Typesense fallback.
JUNIOR_LEX_LEGISLATION_ENABLED=true
JUNIOR_LEX_LEGISLATION_API_URL=https://lex.paralegal.lk
JUNIOR_LEX_LEGISLATION_API_KEY=
JUNIOR_LEX_LEGISLATION_MAX_FIELD_CHARS=12000
DRAFTER_BASE_URL=http://127.0.0.1:8033
DRAFTER_API_KEY=
DRAFTER_REQUEST_TIMEOUT_MS=1200000
TRANSLATOR_BASE_URL=https://www.devtranslate.paralegal.lk/api
TRANSLATOR_API_KEY=

# Optional private, read-only drafting-precedent corpus. It is never copied into
# the image or repository and is not legal authority. For Windows CLI use ROOT as
# the host path. Docker always exposes HOST_PATH inside the container as /kb.
JUNIOR_SILVA_KB_ROOT=
JUNIOR_SILVA_KB_HOST_PATH=

# OpenAI-compatible V2 endpoint and protected artifact downloads.
JUNIOR_SILVA_API_KEY=
JUNIOR_SILVA_PUBLIC_URL=http://127.0.0.1:8132
JUNIOR_SILVA_MODEL_NAME=junior-silva-v2
JUNIOR_SILVA_PORT=8126
JUNIOR_SILVA_BIND_HOST=127.0.0.1
JUNIOR_SILVA_ATTACHMENT_ORIGINS=
JUNIOR_SILVA_DATA_ROOT=
JUNIOR_SILVA_ARTIFACT_ROOT=
JUNIOR_SILVA_UPLOAD_ROOT=
JUNIOR_SILVA_WORKSPACE_ROOT=
JUNIOR_SILVA_ARTIFACT_SECRET=
JUNIOR_SILVA_PI_TIMEOUT_MS=1200000
JUNIOR_SILVA_MAX_BODY_BYTES=62914560
JUNIOR_SILVA_MAX_FILE_BYTES=52428800
